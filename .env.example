# Copy to .env and fill in the values.
MONGODB_URI=mongodb://127.0.0.1:27017/ProjectManagementSystem
SECRET_KEY=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
PORT=3000

# Gmail account used to send emails (use an app password, not your normal password)
MAIL_USER=
MAIL_PASSWORD=
